# Copy to .env for local development. .env is git-ignored; never commit it.

# development | production
APP_ENV=development

# Address the HTTP server listens on.
HTTP_ADDR=:8080

# Matches docker-compose.yml (note host port 5433).
DATABASE_URL=postgres://coach:coach_dev_password@localhost:5433/coach_dev?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info

# text | json. Leave empty: text in development, json in production.
LOG_FORMAT=

# How long in-flight requests get to finish after Ctrl+C / SIGTERM.
SHUTDOWN_TIMEOUT=15s
